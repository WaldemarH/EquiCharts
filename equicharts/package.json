{
  "name": "equicharts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/equicharts.cjs",
  "module": "./dist/equicharts.esm.js",
  "unpkg": "./dist/equicharts.umd.js",
  "types": "./dist/index.d.ts",
  
  "scripts": {
    "lint": "eslint src/**/*.ts",
    "dev": "vite",
    "build": "npm run lint && tsc && vite build",
    "preview": "vite preview",
    "build:dev": "npm run lint && tsc && vite build --mode development",
    "build:prod": "npm run lint && tsc && vite build --mode production",
    "format": "prettier --write \"src/**/*.{js,ts,jsx,tsx,json,md}\""
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.6",
    "tsc-alias": "^1.9.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-dts": "^4.5.4"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write",
      "git add"
    ]
  },
  "eslintIgnore": [
    "node_modules",
    "dist",
    "scripts"
  ]
}
